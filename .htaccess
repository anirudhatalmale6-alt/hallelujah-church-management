RewriteEngine On
RewriteBase /system/

# Force HTTPS (uncomment for production)
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# API Routes - forward to PHP files
RewriteRule ^api/install$ api/install.php [L,QSA]
RewriteRule ^api/auth$ api/auth.php [L,QSA]
RewriteRule ^api/users$ api/users.php [L,QSA]
RewriteRule ^api/users/([0-9]+)$ api/users.php?id=$1 [L,QSA]
RewriteRule ^api/members$ api/members.php [L,QSA]
RewriteRule ^api/members/([0-9]+)$ api/members.php?id=$1 [L,QSA]
RewriteRule ^api/services$ api/services.php [L,QSA]
RewriteRule ^api/services/([0-9]+)$ api/services.php?id=$1 [L,QSA]
RewriteRule ^api/attendance$ api/attendance.php [L,QSA]
RewriteRule ^api/attendance/([0-9]+)$ api/attendance.php?id=$1 [L,QSA]
RewriteRule ^api/dashboard$ api/dashboard.php [L,QSA]
RewriteRule ^api/settings$ api/settings.php [L,QSA]

# Don't rewrite existing files or directories
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Route everything else to index.html (React SPA)
RewriteRule ^(.*)$ public/index.html [L]
