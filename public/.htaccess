RewriteEngine On
RewriteBase /system/public/

# The PDF reader ships an .mjs worker; browsers refuse to run it unless the
# server sends a JavaScript MIME type.
<IfModule mod_mime.c>
AddType text/javascript .mjs
</IfModule>

# Use PHP wrapper as default (bypasses LiteSpeed cache)
DirectoryIndex index.php index.html

# Disable LiteSpeed cache completely
<IfModule LiteSpeed>
CacheLookup off
CacheEnable none /
</IfModule>

# No cache on HTML - always serve fresh
<IfModule mod_headers.c>
Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
Header set Pragma "no-cache"
Header set Expires "Thu, 01 Jan 1970 00:00:00 GMT"
Header set X-LiteSpeed-Cache-Control "no-cache"
</IfModule>

# Don't rewrite existing files (except index pages)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# SPA fallback - use PHP wrapper to bypass cache
RewriteRule ^(.*)$ index.php [L]
